project:
  name: Modern Thai House
  units: m
  version: 1.0
  origin: [0, 0, 0]

building:
  name: Modern Thai House
  storeys:
    - id: GROUND_FLOOR
      name: Ground Floor - Open Stilt Platform
      elevation: 0.0
      height: 3.2
      slabs:
        - id: SLAB_STILT
          name: Raised Platform Deck
          thickness: 0.25
          boundary: [[0, 0], [12, 0], [12, 8], [0, 8]]
      walls:
        - id: WALL_CORE_NORTH
          name: Service Core Wall
          start: [0, 6]
          end: [4, 6]
          thickness: 0.2
          height: 3.2
          openings:
            - id: DOOR_CORE
              offset: 1.0
              width: 0.9
              height: 2.1
      columns:
        - id: COL_STILT_1
          name: Main Stilt Column 1
          position: [0.5, 0.5]
          section: [0.35, 0.35]
          height: 3.2
        - id: COL_STILT_2
          name: Main Stilt Column 2
          position: [11.5, 0.5]
          section: [0.35, 0.35]
          height: 3.2
        - id: COL_STILT_3
          name: Main Stilt Column 3
          position: [11.5, 7.5]
          section: [0.35, 0.35]
          height: 3.2
        - id: COL_STILT_4
          name: Main Stilt Column 4
          position: [0.5, 7.5]
          section: [0.35, 0.35]
          height: 3.2

    - id: FIRST_FLOOR
      name: Upper Living Level
      elevation: 3.2
      height: 3.0
      slabs:
        - id: SLAB_UPPER
          name: Upper Floor Slab
          thickness: 0.2
          boundary: [[0, 0], [12, 0], [12, 8], [0, 8]]
      walls:
        - id: WALL_LIVING_SOUTH
          name: South Glazed Wall
          start: [0, 0]
          end: [12, 0]
          thickness: 0.2
          height: 3.0
          openings:
            - id: WIN_PANORAMA
              offset: 2.0
              width: 8.0
              height: 2.2
              sill_height: 0.4
        - id: WALL_BEDROOM_WEST
          name: West Solid Wall
          start: [0, 0]
          end: [0, 8]
          thickness: 0.2
          height: 3.0
      columns:
        - id: COL_ROOF_SUP_1
          name: Veranda Support Column
          position: [6.0, 0.5]
          radius: 0.15
          height: 3.0
